# =================== DOCKER COMPOSE PORTS: USE THIS PORTS IN docker-compose.yml
DC_BN_HTTP_PROXY_PORT=8088
DC_CLIENT_PORT=8080
DC_API_PORT=3000
DC_POSTGRES_PORT=5432
DC_MAILHOG_WEB_PORT=8025
DC_ADMINER_PORT=8010
DC_BULLBOARD_PORT=3010
DC_PGADMIN_PORT=3020
DC_HTTP_PROXY_AUTH_PORT=8888
DC_MINIO_PORT=9000
DC_MINIO_CONSOLE_PORT=9001
DC_REDIS_PORT=6379

# =================== GENERAL
PORT=3000
NODE_ENV="local" # "local" | "production"
RUN_ENV="local" # "local" | "development" | "staging" | "preproduction" | "production"
WORKER_SYNC_PORT=3042
WORKER_FILE_PORT=3043
APP_HOST="localhost:3000"
PROTOCOL="http"
JWT_URL_EXPIRE_IN="15m"
JWT_URL_SECRET="abcd"
SUPPORT_FORM_URL="https://demarches.numerique.gouv.fr/commencer/siaf-support-technique-et-juridique-aux-prefectures"

# =================== DATABASE
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USERNAME="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="biblio-num"
TYPEORM_FORCE_SYNCHRONIZE="false"

# =================== AUTH
AUTH_PROCONNECT_TOKEN_MAX_AGE=300000
AUTH_JWT_EXPIRE_IN="1h"
AUTH_JWT_REFRESH_EXPIRE_IN="7d"
AUTH_JWT_SECRET=jwtsecret
AUTH_CLIENT_ID="client_id"
AUTH_CLIENT_SECRET="client_secret"
AUTH_REDIRECT_URI="http://localhost:3000/login-callback"
AUTH_DISCOVERY_URL="https://identite-sandbox.proconnect.gouv.fr"
AUTH_DISABLE_SSO=false

# =================== REDIS
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="redis"
REDIS_INDEX=0
REDIS_MAX_RETRY_PER_REQUEST_COUNT=5
REDIS_MAX_LOADING_RETRY=20

# =================== BULL JOBS
BULL_JOB_REMOVE_ON_FAIL="5000"
BULL_JOB_REMOVE_ON_SUCCESS="1000"
BULL_JOB_RETRY_ATTEMPTS=3
BULL_JOB_RETRY_DELAY=10000
BULL_JOB_RETRY_DELAY_TYPE="exponentiel" # "fixed" or "exponentiel"
BULL_JOB_MINUTES_BEFORE_RE_SYNC=1440
BULL_JOB_TIMEOUT=1200000

# =================== Support "local", "s3"
FILE_DRIVER=s3
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=fr-paris-1
AWS_DEFAULT_S3_BUCKET=super-bucket
AWS_DEFAULT_S3_URL=http://127.0.0.1:9000

# =================== MAARCH IMPORT CONFIGURATION
# Nom du bucket S3/MinIO source où sont stockés les fichiers de MAARCH.
AWS_MAARCH_S3_BUCKET=maarch-bucket
# Dossier racine à l'intérieur du bucket MAARCH.
MAARCH_IMPORT_ROOT_PATH=maarch-import-pj
# Dossier à l'intérieur du bucket MAARCH où sont stockés les courriers.
MAARCH_IMPORT_FOLDER_COURRIER="manual"
# Dossier à l'intérieur du bucket MAARCH où sont stockées les pièces jointes.
MAARCH_IMPORT_FOLDER_PIECE_JOINTE="manual_attachements"
# Dossier à l'intérieur du bucket MAARCH où sont stockés les accusés de réception.
MAARCH_IMPORT_FOLDER_ACCUSE_RECEPTION="acknowledgement_receipts"

# =================== CRONJOBS
CRON_SKIP_INITIALIZATION="true"
CRON_SYNC_ALL_DEMARCHE="* 1 * * * *"
#region TODO: BEGIN A supprimer
CRON_SYNC_RNF_ORGANISME="0 0 1 * * *"
CRON_SYNC_RNA_ORGANISME="0 0 1 * * *"
#endregion TODO: BEGIN A supprimer
CRON_COMPUTE_TIME_TRACKING="* 1 * * * *"
CRON_COMPUTE_ORGANISME_DDC="* 2 * * * *"
CRON_ANONYMISE_DOSSIER="* 3 * * * *"

# =================== RANDOM
AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1

# =================== LOGGER
LOG_LEVEL_LOG=true
LOG_LEVEL_ERROR=true
LOG_LEVEL_WARN=true
LOG_LEVEL_DEBUG=false
LOG_LEVEL_VERBOSE=true
LOG_TO_FILE=true

# =================== SMTP
SMTP_SERVER="localhost"
SMTP_PORT="1025"
MAIL_FROM="noreply@interieur.gouv.fr"

# =================== EXTERNAL DEPENDENCIES
# == DS
DS_API_URL="https://demarche.numerique.gouv.fr/api/v2/graphql"
DS_API_TOKEN=""
DS_API_HEALTH=false
# == RNA
RNA_API_URL=""
RNA_API_TOKEN=""
RNA_RECIPIENT=""
# == RNF
RNF_SIAF_API_URL=""
RNF_SIAF_API_TOKEN=""

SIAF_HUB_API_URL=https://dev-api-hub-asso.sdid-app-hp.cpin.numerique-interieur.com/api/v1
SIAF_HUB_API_KEY="1234"
SIAF_HUB_API_HEALTH_PATH=https://dev-api-hub-asso.sdid-app-hp.cpin.numerique-interieur.com/api/health

# =================== OTHER
LOG_DATE_FORMAT="DD/MM/YYYY HH:mm:ss"
NODE_TLS_REJECT_UNAUTHORIZED=0

# =================== SUDO USER
DEFAULT_SUDO_EMAIL="admin@localhost.com"
# Plain text: Password2OpenBN!
DEFAULT_SUDO_HASHED_PASSWORD=$2a$10$obdBhWDN1IyUXK.bi2xzxOZO0/wWXxm3JElK6kW9AV1H8nozXbHle
DEFAULT_SUDO_FORCE_UPSERT=true

# =================== BN CONFIGURATIONS
CREATE_MISSING_MANDATORY_CONFIGURATIONS=true
