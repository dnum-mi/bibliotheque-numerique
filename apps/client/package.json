{
  "name": "@biblio-num/client",
  "type": "module",
  "version": "5.14.0",
  "scripts": {
    "build": "pnpm typecheck && vite build",
    "dev": "vite",
    "dev:e2e": "VITE_CYPRESS=true start-server-and-test 'vite dev --port 5050' http://127.0.0.1:5050/ 'cypress open --e2e'",
    "dev:e2e:ci": "VITE_CYPRESS=true start-server-and-test 'vite dev --port 5050' http://127.0.0.1:5050/ 'cypress run --e2e'",
    "format": "eslint . --fix",
    "generate-icons": "vue-dsfr-icons -s scripts/icons.js -t src/icon-collections.ts",
    "lint": "eslint .",
    "lint:staged": "eslint ",
    "pretest:e2e": "npm run build",
    "pretest:e2e:ci": "npm run build",
    "preview": "CYPRESS=true vite preview --port 5050",
    "test": "run-s test:unit test:ct:ci dev:e2e:ci",
    "test:ct": "CYPRESS=true cypress open --component",
    "test:ct:ci": "NODE_ENV=production CYPRESS=true cypress run --component --browser chrome",
    "test:e2e": "start-server-and-test preview http://127.0.0.1:5050/ 'cypress open --e2e'",
    "test:e2e:ci": "start-server-and-test preview http://127.0.0.1:5050/ 'cypress run --e2e'",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --composite false"
  },
  "dependencies": {
    "@biblio-num/shared": "workspace:^",
    "@gouvfr/dsfr": "^1.14.1",
    "@gouvminint/vue-dsfr": "8.8.0",
    "@primeuix/themes": "1.2.3",
    "@primevue/core": "4.4.1",
    "@primevue/themes": "4.4.1",
    "@vee-validate/zod": "^4.12.6",
    "@vue-leaflet/vue-leaflet": "0.10.1",
    "@vueuse/core": "^14.0.0",
    "axios": "^1.15.1",
    "leaflet": "1.9.4",
    "lucide-vue-next": "0.561.0",
    "maska": "3.2.0",
    "oh-vue-icons": "1.0.0-rc3",
    "ol": "10.6.1",
    "ol-contextmenu": "5.5.0",
    "ol-ext": "4.0.36",
    "pinia": "^3.0.1",
    "pretty-bytes": "^6.1.1",
    "primevue": "4.4.1",
    "sanitize-html": "^2.17.3",
    "shepherd.js": "14.5.1",
    "slugify": "^1.6.6",
    "vee-validate": "^4.14.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue3-openlayers": "^12.1.1",
    "zod": "^4.1.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.1",
    "@cypress/vue": "^6.0.3",
    "@dnum-mi/ds-api-client": "^1.9.2",
    "@faker-js/faker": "^10.0.0",
    "@iconify-json/fa": "1.2.2",
    "@iconify-json/ri": "1.2.6",
    "@iconify-json/vscode-icons": "1.2.33",
    "@iconify/vue": "4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "22.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.19.1",
    "@types/sanitize-html": "2.16.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "cypress": "15.14.0",
    "eslint": "^9.39.2",
    "eslint-plugin-cypress": "^5.2.0",
    "jsdom": "^26.1.0",
    "msw": "2.10.5",
    "npm-run-all": "^4.1.5",
    "sass": "^1.81.0",
    "start-server-and-test": "^2.0.12",
    "typescript": "5.8.3",
    "unocss": "^66.6.8",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^8.0.9",
    "vite-plugin-checker": "0.13.0",
    "vite-plugin-commonjs": "0.10.4",
    "vite-plugin-pwa": "^1.2.0",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^4.0.8",
    "vue-tsc": "^3.0.6",
    "workbox-window": "^7.3.0"
  },
  "volta": {
    "node": "24.13.0",
    "pnpm": "11.6.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
